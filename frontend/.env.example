# Deployed AxelTournament hub (one hub hosts unlimited tournaments).
# Testnet default — point .env.local at whichever hub you're using.
NEXT_PUBLIC_AXEL_ADDRESS=0x_your_hub_address_here
# Mainnet hub slot — the app switches to it automatically on Arc mainnet (5042).
NEXT_PUBLIC_AXEL_ADDRESS_MAINNET=0x_your_mainnet_hub_address_here
# Optional: enables WalletConnect QR in the wallet modal (free at https://cloud.walletconnect.com)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
